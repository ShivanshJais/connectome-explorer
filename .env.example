# Copy to .env and set a real password. .env is gitignored.
POSTGRES_USER=admin
POSTGRES_PASSWORD=change-me
POSTGRES_DB=connectome_data

# Django. Generate a key with the command below. Avoid keys containing $,
# because Compose treats $name in .env as a variable reference.
# python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me
